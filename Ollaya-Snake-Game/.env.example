# Snake web server / published port
PORT=8787

# Ollaya System 1 semantic decision endpoint (reachable from Docker on the host)
OLLAYA_API_URL=http://host.docker.internal:11435/v1/systemone
OLLAYA_MODEL=laya
OLLAYA_API_TOKEN=

# Optional System 2 rule evolution endpoint credential; only needed for AI rule evolution
OPENAI_API_KEY=
